# Copy to .env.local (for local dev) and set the same values in the Vercel
# project's Environment Variables (for production) once a Supabase project
# and Stripe account exist. Until then, src/lib/supabase/client.ts stays
# inert and every subject is free — nothing here is required to run the app.
# See README.md's "Publishing & monetisation" section for the full setup
# checklist these variables belong to.

# Supabase project settings → API. Safe to expose to the browser (that's
# what VITE_ means — Vite inlines it into client JS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase project settings → API → service_role key. NEVER put a VITE_
# prefix on this — it must stay server-only (used by /api functions to
# bypass RLS, e.g. the Stripe webhook writing subscription status).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe dashboard → Developers → API keys (use the *secret* key, not the
# publishable one — server-only, no VITE_ prefix).
STRIPE_SECRET_KEY=
# Stripe dashboard → Product catalog → your subscription product → the
# recurring Price's id (starts with "price_").
STRIPE_PRICE_ID=
# Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
# (starts with "whsec_").
STRIPE_WEBHOOK_SECRET=

# Your production URL (e.g. https://studyquick.vercel.app), used to build
# Stripe Checkout/portal redirect links server-side. Optional locally — the
# API functions fall back to the request's own Host header.
APP_URL=
